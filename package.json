{
  "name": "telajunta",
  "version": "1.0.0",
  "description": "Compartilhamento remoto de tela e colaboracao privada",
  "main": "src/main.cjs",
  "author": "TelaJunta",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.cjs",
    "test": "node --test",
    "build:icons": "node scripts/create-icons.cjs",
    "build:win": "npm run build:icons && electron-builder --win nsis portable && node scripts/copy-portable.cjs",
    "build:linux": "npm run build:icons && electron-builder --linux AppImage deb",
    "build:mac": "npm run build:icons && electron-builder --mac dmg",
    "build:all": "npm run build:icons && electron-builder --win nsis --linux AppImage deb --mac dmg"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "com.telajunta.desktop",
    "productName": "TelaJunta",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.icns",
      "assets/icon.png",
      "package.json",
      "!server/**/*",
      "!scripts/**/*"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TelaJunta",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "target": ["AppImage", "deb"]
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking",
      "target": ["dmg"]
    }
  }
}
